{
  "name": "peru-press",
  "version": "0.1.0",
  "private": true,
  "description": "Removes the client-side paywall on Grupo El Comercio news sites.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
